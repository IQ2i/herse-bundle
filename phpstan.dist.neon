includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        # A separate application with its own vendor directory: see tests/SyliusApplication/composer.json.
        - tests/SyliusApplication
        # Auto-generated by Symfony's config dumper (gitignored), sometimes present locally.
        - tests/TestApplication/config/reference.php (?)
    fileExtensions:
        - php
    ignoreErrors:
        # AbstractType and FormInterface are generic from Symfony 7.x only.
        -
            identifier: missingType.generics
            reportUnmatched: false
