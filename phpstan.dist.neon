includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        # A separate application with its own vendor directory: see tests/SyliusApplication/composer.json.
        - tests/SyliusApplication
        # Same for the MokaCMS application: see tests/MokaApplication/composer.json.
        - tests/MokaApplication
        # The classes extending or listening to MokaCMS: a private package that cannot be installed here. They are
        # covered by tests/MokaApplication only.
        - src/Bridge/Moka/DependencyInjection/MokaUserClassPass.php
        - src/Bridge/Moka/EventListener
        - src/Bridge/Moka/Form
        - src/Bridge/Moka/Generator
        - src/Bridge/Moka/Mapping
        - src/Bridge/Moka/Model
        # Auto-generated by Symfony's config dumper (gitignored), sometimes present locally.
        - tests/TestApplication/config/reference.php (?)
    fileExtensions:
        - php
    ignoreErrors:
        # AbstractType and FormInterface are generic from Symfony 7.x only.
        -
            identifier: missingType.generics
            reportUnmatched: false
