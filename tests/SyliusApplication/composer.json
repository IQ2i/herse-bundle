{
  "name": "iq2i/herse-bundle-sylius-application",
  "type": "project",
  "description": "Sylius application used to test the Herse bundle",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "doctrine/doctrine-bundle": "*",
    "scheb/2fa-bundle": "^7.0|^8.0",
    "scheb/2fa-email": "^7.0|^8.0",
    "scheb/2fa-trusted-device": "^7.0|^8.0",
    "sylius/sylius": "~2.2.0 || ~2.3.0",
    "symfony/mailer": "^6.4|^7.4|^8.0",
    "symfony/rate-limiter": "^6.4|^7.4|^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5|^11.5",
    "symfony/browser-kit": "^6.4|^7.4|^8.0",
    "symfony/phpunit-bridge": "^7.4|^8.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": false,
      "php-http/discovery": true,
      "dealerdirect/phpcodesniffer-composer-installer": false
    },
    "policy": {
      "advisories": {
        "block": false
      }
    }
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "IQ2i\\HerseBundle\\": "../../src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  }
}
