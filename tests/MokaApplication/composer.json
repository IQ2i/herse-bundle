{
  "name": "iq2i/herse-bundle-moka-application",
  "type": "project",
  "description": "MokaCMS application used to test the Herse bundle. Every Symfony package is pinned to 6.4, as Flex does in a Moka project: Moka does not run on Symfony 7.",
  "license": "proprietary",
  "repositories": [
    {
      "type": "path",
      "url": "/srv/moka",
      "options": {
        "symlink": false,
        "versions": {
          "moka/cms": "1.1.2"
        }
      }
    }
  ],
  "require": {
    "php": ">=8.2",
    "doctrine/doctrine-bundle": "^2.12",
    "doctrine/orm": "^2.19",
    "moka/cms": "^1.1",
    "scheb/2fa-bundle": "^7.0",
    "scheb/2fa-email": "^7.0",
    "scheb/2fa-trusted-device": "^7.0",
    "symfony/asset": "6.4.*",
    "symfony/clock": "6.4.*",
    "symfony/console": "6.4.*",
    "symfony/doctrine-bridge": "6.4.*",
    "symfony/error-handler": "6.4.*",
    "symfony/finder": "6.4.*",
    "symfony/form": "6.4.*",
    "symfony/framework-bundle": "6.4.*",
    "symfony/intl": "6.4.*",
    "symfony/mailer": "6.4.*",
    "symfony/password-hasher": "6.4.*",
    "symfony/process": "6.4.*",
    "symfony/rate-limiter": "6.4.*",
    "symfony/routing": "6.4.*",
    "symfony/security-bundle": "6.4.*",
    "symfony/translation": "6.4.*",
    "symfony/twig-bundle": "6.4.*",
    "symfony/validator": "6.4.*",
    "symfony/var-dumper": "6.4.*",
    "symfony/var-exporter": "6.4.*",
    "symfony/yaml": "6.4.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5|^11.5",
    "symfony/browser-kit": "6.4.*",
    "symfony/css-selector": "6.4.*",
    "symfony/dom-crawler": "6.4.*",
    "symfony/stopwatch": "6.4.*"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": false
    }
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "IQ2i\\HerseBundle\\": "../../src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  }
}
