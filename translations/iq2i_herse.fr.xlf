<?xml version="1.0" encoding="UTF-8" ?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
    <file source-language="en" target-language="fr" datatype="plaintext" original="file.ext">
        <body>
            <trans-unit id="password_changed.subject">
                <source>Your password has been changed</source>
                <target>Votre mot de passe a été modifié</target>
            </trans-unit>
            <trans-unit id="password_changed.intro">
                <source>The password of your account has just been changed.</source>
                <target>Le mot de passe de votre compte vient d'être modifié.</target>
            </trans-unit>
            <trans-unit id="password_changed.date">
                <source>Date and time of the change: %date%.</source>
                <target>Date et heure de la modification : %date%.</target>
            </trans-unit>
            <trans-unit id="password_changed.warning">
                <source>If you did not make this change, contact us as soon as possible and secure your account.</source>
                <target>Si vous n'êtes pas à l'origine de cette modification, contactez-nous au plus vite et sécurisez votre compte.</target>
            </trans-unit>
            <trans-unit id="new_device.subject">
                <source>New sign-in to your account</source>
                <target>Nouvelle connexion à votre compte</target>
            </trans-unit>
            <trans-unit id="new_device.intro">
                <source>Your account has just been accessed from a device we did not know.</source>
                <target>Votre compte vient d'être utilisé depuis un appareil que nous ne connaissions pas.</target>
            </trans-unit>
            <trans-unit id="new_device.device">
                <source>Device: %device%</source>
                <target>Appareil : %device%</target>
            </trans-unit>
            <trans-unit id="new_device.unknown">
                <source>Unknown device</source>
                <target>Appareil inconnu</target>
            </trans-unit>
            <trans-unit id="new_device.ip">
                <source>IP address: %ip%</source>
                <target>Adresse IP : %ip%</target>
            </trans-unit>
            <trans-unit id="new_device.date">
                <source>Date and time: %date%</source>
                <target>Date et heure : %date%</target>
            </trans-unit>
            <trans-unit id="new_device.warning">
                <source>If this was you, nothing more to do. Otherwise, change your password and revoke this device as soon as possible.</source>
                <target>S'il s'agit de vous, rien d'autre à faire. Sinon, changez votre mot de passe et révoquez cet appareil au plus vite.</target>
            </trans-unit>
            <trans-unit id="two_factor_code.subject">
                <source>Your sign-in code</source>
                <target>Votre code de connexion</target>
            </trans-unit>
            <trans-unit id="two_factor_code.code">
                <source>Your sign-in code is: %code%</source>
                <target>Votre code de connexion est : %code%</target>
            </trans-unit>
            <trans-unit id="two_factor_code.warning">
                <source>If you did not try to sign in, change your password as soon as possible.</source>
                <target>Si vous n'avez pas essayé de vous connecter, changez votre mot de passe au plus vite.</target>
            </trans-unit>
            <trans-unit id="password_policy.length">
                <source>at least %count% characters</source>
                <target>au moins %count% caractères</target>
            </trans-unit>
            <trans-unit id="password_policy.lowercase">
                <source>a lowercase letter</source>
                <target>une lettre minuscule</target>
            </trans-unit>
            <trans-unit id="password_policy.uppercase">
                <source>an uppercase letter</source>
                <target>une lettre majuscule</target>
            </trans-unit>
            <trans-unit id="password_policy.digit">
                <source>a digit</source>
                <target>un chiffre</target>
            </trans-unit>
            <trans-unit id="password_policy.special">
                <source>a special character</source>
                <target>un caractère spécial</target>
            </trans-unit>
            <trans-unit id="password_policy.some_types">
                <source>at least %count% of these: %types%</source>
                <target>au moins %count% de ces éléments : %types%</target>
            </trans-unit>
            <trans-unit id="two_factor.title">
                <source>Two-factor authentication</source>
                <target>Double authentification</target>
            </trans-unit>
            <trans-unit id="two_factor.intro_email">
                <source>Enter the code we have just sent to your email address.</source>
                <target>Saisissez le code que nous venons d'envoyer à votre adresse e-mail.</target>
            </trans-unit>
            <trans-unit id="two_factor.intro_totp">
                <source>Enter the code shown by your authenticator app.</source>
                <target>Saisissez le code affiché par votre application d'authentification.</target>
            </trans-unit>
            <trans-unit id="two_factor.code">
                <source>Code</source>
                <target>Code</target>
            </trans-unit>
            <trans-unit id="two_factor.trusted">
                <source>Trust this device</source>
                <target>Faire confiance à cet appareil</target>
            </trans-unit>
            <trans-unit id="two_factor.verify">
                <source>Verify</source>
                <target>Valider</target>
            </trans-unit>
            <trans-unit id="two_factor.cancel">
                <source>Cancel</source>
                <target>Annuler</target>
            </trans-unit>
        </body>
    </file>
</xliff>
